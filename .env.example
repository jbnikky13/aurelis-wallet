# Optional market data
NEXT_PUBLIC_COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Optional Supabase integration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Arc Mainnet RPC override.
# Default is the public Arcscan gateway; replace with Circle/your node provider
# when an official production endpoint is selected.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.arc-scan.org

# Server-only explorer indexing for transaction history.
# Keep this secret; do NOT prefix with NEXT_PUBLIC_.
ETHERSCAN_API_KEY=

# Never commit private keys, seed phrases, or service-role secrets.
